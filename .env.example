AGI_ENVIRONMENT=development
AGI_DATABASE_URL=sqlite:///./data/agi.db
AGI_BOOTSTRAP_TOKEN=replace-this-one-time-token
AGI_SESSION_SECRET=replace-with-at-least-32-random-characters
AGI_MASTER_KEY=replace-with-a-docker-secret-in-production
# Production Compose uses the ignored .secrets/ files created by initialize-secrets.
AGI_BOOTSTRAP_TOKEN_HOST_FILE=.secrets/bootstrap_token
AGI_SESSION_SECRET_HOST_FILE=.secrets/session_secret
AGI_MASTER_KEY_HOST_FILE=.secrets/master_key
AGI_DEMO_NO_AUTH=false
AGI_KNOWLEDGE_ROOT=knowledge
AGI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AGI_MODEL_PROFILE=local-balanced
AGI_QMD_URL=
AGI_CLOUD_MODELS_ENABLED=false
# Cloud Model Gateway Configuration (e.g. Gemini, OpenAI compatible APIs)
# Explicit cloud model opt-in settings read with AGI_ prefix:
AGI_CLOUD_PROVIDER=gemini
AGI_CLOUD_MODEL=gemini-2.5-flash
# Host path used by docker-compose.cloud.yml. The key itself is never stored in .env.
AGI_CLOUD_API_KEY_HOST_FILE=.secrets/cloud_model_api_key
AGI_OTLP_ENDPOINT=
POSTGRES_DB=agi
POSTGRES_USER=agi
POSTGRES_PASSWORD=change-me
